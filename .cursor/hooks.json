{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-start.mjs"
      }
    ],
    "preCompact": [
      {
        "command": "node .cursor/hooks/pre-compact.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-continue.mjs",
        "loop_limit": null
      }
    ],
    "sessionEnd": [
      {
        "command": "node .cursor/hooks/session-end.mjs"
      }
    ]
  }
}
