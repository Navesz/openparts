{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navesz.github.io/openparts/schemas/catalog.schema.json",
  "title": "Open Parts catalog",
  "type": "object",
  "required": ["schemaVersion", "name", "description", "vehicles", "parts", "equivalences"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "vehicles": {
      "type": "array",
      "items": { "$ref": "#/$defs/vehicle" }
    },
    "parts": {
      "type": "array",
      "items": { "$ref": "#/$defs/part" }
    },
    "equivalences": {
      "type": "array",
      "items": { "$ref": "#/$defs/equivalence" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["kind", "summary"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["synthetic-demo", "public-article", "curator-note", "user-import"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "accessed": { "type": "string" }
      }
    },
    "vehicle": {
      "type": "object",
      "required": [
        "id",
        "make",
        "model",
        "generation",
        "market",
        "years",
        "notes",
        "relatedPlatformNotes",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "make": { "const": "Chevrolet" },
        "model": { "const": "Vectra" },
        "generation": { "type": "string", "enum": ["A", "B", "C"] },
        "market": { "const": "BR" },
        "years": { "type": "string" },
        "notes": { "type": "string" },
        "relatedPlatformNotes": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "id",
        "code",
        "brand",
        "label",
        "category",
        "safetyClass",
        "fitsVehicleIds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "brand": { "type": "string" },
        "label": { "type": "string" },
        "category": { "type": "string" },
        "safetyClass": {
          "type": "string",
          "enum": ["non-critical", "wear-item", "safety-critical", "unknown"]
        },
        "fitsVehicleIds": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "equivalence": {
      "type": "object",
      "required": [
        "id",
        "fromPartId",
        "toPartId",
        "confidence",
        "reason",
        "bidirectional",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "fromPartId": { "type": "string" },
        "toPartId": { "type": "string" },
        "confidence": {
          "type": "string",
          "enum": ["curated", "synthetic", "community-proposed", "do-not-advise"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "bidirectional": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
